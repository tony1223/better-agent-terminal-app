default_platform(:ios)

APP_IDENTIFIER = "com.tonyq.betteragentterminal"
XCODEPROJ = "BATMobile.xcodeproj"
WORKSPACE = "BATMobile.xcworkspace"
SCHEME = "BATMobile"
TEAM_ID = "8JVDJGLLYR"

platform :ios do
  desc "One-time: generate the Apple Distribution cert + App Store profile into ./signing"
  lane :bootstrap_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    out = File.expand_path("../signing", __dir__)
    FileUtils.mkdir_p(out)

    # Create (or reuse, if the private key is already in this keychain) the cert.
    cert(
      api_key: api_key,
      generate_apple_certs: true,
      output_path: out,
    )

    # Create / download the App Store provisioning profile for this app id.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      output_path: out,
    )

    UI.success("Signing assets written to #{out}")
  end

  desc "Build a Release IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    # Create an isolated temporary keychain on CI and make it the default.
    # Exposes MATCH_KEYCHAIN_NAME / MATCH_KEYCHAIN_PASSWORD for the import below.
    setup_ci(force: true)

    # Import the Apple Distribution certificate (.p12) into the temp keychain.
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_PATH"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD", ""),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", ""),
    )

    # Read the provisioning profile (name + UUID) and install it where Xcode looks.
    profile_path = ENV.fetch("PROVISIONING_PROFILE_PATH")
    require "plist"
    profile = Plist.parse_xml(`security cms -D -i "#{profile_path}"`)
    profile_name = profile.fetch("Name")
    profile_uuid = profile.fetch("UUID")
    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    FileUtils.cp(profile_path, File.join(profiles_dir, "#{profile_uuid}.mobileprovision"))

    # CI has no logged-in Xcode account, so switch the app target to manual signing
    # pointing at the profile we just installed. Only affects the CI working copy.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      targets: [SCHEME],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: profile_name,
    )

    # Optional marketing version override (e.g. 1.0.1).
    marketing = ENV["MARKETING_VERSION"]
    unless marketing.nil? || marketing.strip.empty?
      increment_version_number(xcodeproj: XCODEPROJ, version_number: marketing.strip)
    end

    version = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)

    # Pick a build number that is guaranteed higher than what TestFlight already has.
    build_number =
      begin
        latest = latest_testflight_build_number(
          api_key: api_key,
          app_identifier: APP_IDENTIFIER,
          version: version,
          initial_build_number: 0,
        )
        (latest.to_i + 1).to_s
      rescue => e
        UI.important("Falling back on build number (#{e.message})")
        env_bn = ENV["BUILD_NUMBER"]
        (env_bn.nil? || env_bn.strip.empty?) ? Time.now.strftime("%Y%m%d%H%M") : env_bn.strip
      end

    increment_build_number(xcodeproj: XCODEPROJ, build_number: build_number)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Print the app's App Store version states (read-only)"
  lane :appstore_status do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No app found for #{APP_IDENTIFIER}") if app.nil?

    UI.header("App Store versions for #{APP_IDENTIFIER}")
    # submit_review fails with "cannot create a new version in the current
    # state" whenever one of these is parked in a non-editable state — this is
    # the list that says which one.
    app.get_app_store_versions.each do |v|
      state = %i[app_store_state state].find { |m| v.respond_to?(m) && v.send(m) }
      UI.message("  #{v.version_string.to_s.ljust(12)} #{state ? v.send(state) : 'unknown'}  (#{v.platform})")
    end

    UI.header("Recent TestFlight builds")
    # A Build carries its marketing version through pre_release_version, not
    # through app_store_version — that association is only populated once the
    # build is attached to an App Store version.
    app.get_builds(sort: "-uploadedDate", limit: 5).each do |b|
      marketing = b.pre_release_version&.version || "-"
      UI.message("  build #{b.version.to_s.ljust(6)} of #{marketing.to_s.ljust(12)} processing=#{b.processing_state}")
    end
  end

  desc "Submit a build that is already on TestFlight to App Store review"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    version = ENV.fetch("SUBMIT_VERSION", "").strip
    UI.user_error!("SUBMIT_VERSION is required (e.g. 1.0.35)") if version.empty?

    # Blank = whatever build App Store Connect already has for this version.
    # Pass it explicitly to pin the exact artifact instead.
    build_number = ENV.fetch("SUBMIT_BUILD_NUMBER", "").strip
    build_number = nil if build_number.empty?

    notes = ENV.fetch("SUBMIT_RELEASE_NOTES", "").strip
    locale = ENV.fetch("SUBMIT_LOCALE", "en-US").strip
    submit = ENV.fetch("SUBMIT_FOR_REVIEW", "true") == "true"
    auto_release = ENV.fetch("SUBMIT_AUTOMATIC_RELEASE", "true") == "true"

    # No release notes means leave the listing exactly as it stands in App Store
    # Connect. deliver would otherwise take the metadata round trip, and with no
    # ./fastlane/metadata in this repo there is nothing to sync back from — the
    # empty-notes case is the one that gets an update bounced by review.
    skip_metadata = notes.empty?

    notes_summary = skip_metadata ? "left as-is in App Store Connect" : "#{notes.length} chars for #{locale}"
    UI.message("Submitting #{version} (build #{build_number || 'latest on the version'})")
    UI.message("  submit_for_review  #{submit}")
    UI.message("  automatic_release  #{auto_release}")
    UI.message("  release notes      #{notes_summary}")

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      app_version: version,
      build_number: build_number,

      # The binary is already on TestFlight — this lane only moves it into an
      # App Store version and submits. Rebuilding would mint a different
      # artifact than the one that was tested.
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: skip_metadata,
      release_notes: skip_metadata ? nil : { locale => notes },

      submit_for_review: submit,
      automatic_release: auto_release,

      # Non-interactive: deliver otherwise opens an HTML preview and waits for
      # a confirmation that never comes on CI.
      force: true,

      # precheck's in-app-purchase scan is not covered by App Store Connect API
      # key auth and fails the run; the app ships no IAP anyway.
      precheck_include_in_app_purchases: false,

      # Mirrors what the binary already declares: ITSAppUsesNonExemptEncryption
      # false in Info.plist, NSPrivacyTracking false in PrivacyInfo.xcprivacy.
      # These are legal declarations — if either plist changes, change these.
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
      },
    )

    if submit
      UI.success("#{version} submitted for review. Apple review is typically ~24h.")
    else
      UI.success("#{version} staged in App Store Connect — not submitted.")
    end
  end
end
